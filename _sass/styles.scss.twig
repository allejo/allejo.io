@charset 'UTF-8';

// The colors we care about, this is in Twig so that I can generate a Sass map
// of colors, that I can then use in a Sass loop to generate CSS classes for each
// language.
{% set languages = ['CSS', 'Go', 'HTML', 'JavaScript', 'Liquid', 'PHP', 'TypeScript'] %}

// Colors come from GitHub's Linguist library.
//   https://github.com/ozh/github-colors/blob/master/colors.json
$languages: (
    {% for lang in languages %}
        {{ lang | lower }}: {{ data.github_colors[lang].color }},
    {% endfor %}
);

